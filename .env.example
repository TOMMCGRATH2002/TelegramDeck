# ─────────────────────────────────────────────────────────────
#  TelegramDeck — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Required for the server to talk to Telegram (one session for everyone). Run `npm run auth` on the
# server or a trusted machine, then paste the string here. Deck usernames in the app do not replace this.
TELEGRAM_SESSION=

# Server config
PORT=3000
# Required in production (NODE_ENV=production): ≥32 random characters. Never commit real secrets.
SESSION_SECRET=change_this_to_a_random_secret_string
# Optional: comma-separated browser origins (default: localhost, 127.0.0.1, telegramdeck.local on PORT)
# APP_ORIGINS=http://localhost:3000,http://telegramdeck.local:3000
# Optional: set SESSION_COOKIE_SECURE=1 only when serving over HTTPS
# Optional: TRUST_PROXY=1 when behind a reverse proxy (for accurate rate limits)
# Optional friendly hostname: add "127.0.0.1 telegramdeck.local" to your OS hosts file, then open http://telegramdeck.local:PORT

# ─── Production (public HTTPS site) ─────────────────────────
# NODE_ENV=production
# APP_ORIGINS=https://yourdomain.com
# SESSION_COOKIE_SECURE=1
# TRUST_PROXY=1
# TELEGRAMDECK_CSP=0   # only for debugging CSP issues; leave unset in production

# Optional: Google Translate API key for server-side translation
# If blank, translation is skipped and the frontend handles it via display toggle only
GOOGLE_TRANSLATE_API_KEY=

# ─── Truth Social (optional deck columns; truthbrush) ─
# @see https://github.com/stanfordio/truthbrush
# TRUTHSOCIAL_TOKEN=
# TRUTHSOCIAL_USERNAME=
# TRUTHSOCIAL_PASSWORD=
# Native / systemd: TRUTHBRUSH_BIN=/root/.local/bin/truthbrush (pipx) or path to venv
# Docker image: truthbrush is at /app/.venv/bin/truthbrush — do NOT set host paths like /root/.local/...
# TRUTHBRUSH_BIN=/app/.venv/bin/truthbrush
# TRUTHBRUSH_TIMEOUT_MS=90000
# TRUTH_FEED_HANDLE=realDonaldTrump
# TELEGRAMDECK_TRUTH_ERRORS=1   # optional: return truthbrush error text in API (502) instead of generic 500
